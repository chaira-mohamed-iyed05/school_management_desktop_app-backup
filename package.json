{
  "name": "edupilot-dz",
  "productName": "Edupilot DZ",
  "private": true,
  "version": "1.0.0",
  "description": "Système de gestion scolaire hors ligne — إدارة المدرسة بدون إنترنت",
  "author": {
    "name": "Edupilot DZ"
  },
  "main": "out/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:reset-data": "node scripts/reset-dev-data.cjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.cjs",
    "seed:dev": "node scripts/seed-dev.cjs",
    "icon:build": "node scripts/generate-icons.cjs",
    "fonts:download": "node scripts/download-fonts.cjs",
    "dist:win": "electron-vite build && electron-builder --win nsis",
    "dist:win:dir": "electron-vite build && electron-builder --win dir",
    "verify": "pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.44.2",
    "electron-log": "^5.3.4",
    "electron-updater": "^6.6.2",
    "extract-zip": "^2.0.1",
    "i18next": "^25.3.1",
    "lucide-react": "^1.28.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.84.0",
    "react-i18next": "^15.5.3",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.53.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/extract-zip": "^2.0.3",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.0",
    "electron": "^32.3.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^2.3.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.1.0",
    "png-to-ico": "^2.1.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  }
}
